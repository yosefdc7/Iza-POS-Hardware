// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  CASHIER
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

// ============================================================
// Auth models (required by Better Auth)
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(CASHIER)
  pin           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales            Sale[]
  sessions         Session[]
  accounts         Account[]
  stockAdjustments StockAdjustment[]
  refunds          Refund[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// Product
// ============================================================

model Product {
  id                String   @id @default(cuid())
  name              String
  sku               String?  @unique
  barcode           String?  @unique
  price             Decimal
  cost              Decimal?
  stock             Decimal  @default(0) @db.Decimal(14, 4)
  unit              String   @default("pc")
  quantityPrecision Int      @default(0)
  category          String?
  imageUrl          String?
  lowStockThreshold Decimal  @default(5) @db.Decimal(14, 4)
  active            Boolean  @default(true)
  supplierId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  packagings       ProductPackaging[]
}

// ============================================================
// Product Packaging (optional; products without packagings work as before)
// ============================================================

model ProductPackaging {
  id            String   @id @default(cuid())
  productId     String
  name          String
  /// Number of base units per 1 packaging unit (e.g. 100 for a box of 100 nails).
  conversionQty Decimal  @db.Decimal(14, 4)
  /// Independent sell price — not derived from base product price.
  price         Decimal
  barcode       String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]
}


// ============================================================
// Customer
// ============================================================

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?  @unique
  email         String?  @unique
  notes         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales       Sale[]
  loyaltyLogs LoyaltyLog[]
}

// ============================================================
// Sales
// ============================================================

model Sale {
  clientRequestId String? @unique
  requestFingerprint String?
  id              String        @id @default(cuid())
  userId          String
  customerId      String?
  subtotal        Decimal
  taxRate         Decimal       @default(0)
  taxAmount       Decimal
  discountAmount  Decimal       @default(0)
  tipAmount       Decimal?
  total           Decimal
  paymentMethod   PaymentMethod @default(CASH)
  paymentLines    Json?
  amountTendered  Decimal?
  changeDue       Decimal?
  status          SaleStatus    @default(COMPLETED)
  receiptSeriesId String?
  receiptNumber   Int?
  legacyReference String?
  backfilled      Boolean       @default(false)
  voidReason      String?
  notes           String?
  drSiNumber      String?
  createdAt       DateTime      @default(now())

  user          User           @relation(fields: [userId], references: [id])
  receiptSeries ReceiptSeries? @relation(fields: [receiptSeriesId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  refunds       Refund[]
  loyaltyLogs   LoyaltyLog[]

  @@unique([receiptSeriesId, receiptNumber])
}

model ReceiptSeries {
  id         String   @id @default(cuid())
  name       String   @unique
  nextNumber Int      @default(1)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales Sale[]
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  productId    String?
  name         String
  price        Decimal
  basePrice    Decimal? @db.Decimal(14, 4)
  quantity     Decimal  @db.Decimal(14, 4)
  unit         String   @default("pc")
  unitCost     Decimal? @db.Decimal(14, 4)
  total        Decimal
  notes        String?
  /// FK to the packaging used at time of sale. Null = base unit sale.
  packagingId  String?
  /// Snapshot of conversionQty at time of sale (for refund calculations).
  packagingQty Decimal? @db.Decimal(14, 4)

  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  packaging ProductPackaging? @relation(fields: [packagingId], references: [id], onDelete: SetNull)
}

// ============================================================
// Held Orders (POS "Park Sale" feature)
// ============================================================

model HeldOrder {
  id           String   @id @default(cuid())
  label        String?
  cartSnapshot Json
  createdAt    DateTime @default(now())
}

// ============================================================
// Loyalty
// ============================================================

enum LoyaltyLogType {
  EARN
  REDEEM
  ADJUST
}

model LoyaltyLog {
  id         String         @id @default(cuid())
  customerId String
  saleId     String?
  delta      Int
  type       LoyaltyLogType
  note       String?
  createdAt  DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
}

// ============================================================
// Inventory
// ============================================================

enum StockAdjReason {
  RECEIVED
  DAMAGED
  THEFT
  CORRECTION
  OPENING_COUNT
}

model StockAdjustment {
  id        String         @id @default(cuid())
  productId String
  userId    String
  delta     Decimal        @db.Decimal(14, 4)
  reason    StockAdjReason
  note      String?
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

// ============================================================
// Refunds
// ============================================================

model Refund {
  id           String   @id @default(cuid())
  saleId       String
  userId       String
  amount       Decimal
  reason       String?
  items        Json
  restoreStock Boolean  @default(true)
  createdAt    DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// Business Settings (single-row singleton)
// ============================================================

model BusinessSettings {
  id                 String   @id @default("singleton")
  name               String   @default("My Store")
  logoUrl            String?
  primaryColor       String   @default("#0f2044")
  accentColor        String   @default("#f5c518")
  currency           String   @default("₱")
  currencyDecimals   Int      @default(2)
  taxRate            Decimal  @default(0)
  taxName            String   @default("Tax")
  receiptFooter      String   @default("Thank you for your purchase!")
  language           String   @default("en")
  businessTimezone   String   @default("Asia/Manila")
  // Loyalty
  loyaltyEnabled     Boolean  @default(false)
  loyaltyEarnRate    Decimal  @default(1) // points per ₱1 spent
  loyaltyRedeemValue Decimal  @default(100) // points per ₱1 discount
  // Low-stock
  lowStockThreshold  Int      @default(5)
  // Image storage
  storageProvider    String   @default("local") // local | supabase
  storageRegion      String?
  storageBucket      String?
  storageEndpoint    String?
  storageAccessKey   String?
  storageSecretKey   String?
  storagePublicUrl   String?
  posAutoLockMinutes Int      @default(0)
  setupComplete      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
